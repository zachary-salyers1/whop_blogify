// Whop Blogify Database Schema
// PostgreSQL via Neon
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USERS & COMPANIES
// ============================================================================

model User {
  id                 String   @id // Whop user ID (user_xxx)
  username           String?
  name               String?
  email              String?
  profilePicUrl      String?  @map("profile_pic_url")
  profilePicUrl32    String?  @map("profile_pic_url_32")
  profilePicUrl64    String?  @map("profile_pic_url_64")
  profilePicUrl128   String?  @map("profile_pic_url_128")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  posts              Post[]
  likes              Like[]
  comments           Comment[]
  userCompanies      UserCompany[]
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent  Notification[] @relation("NotificationActor")
  reports            Report[]

  @@index([username])
  @@index([email])
  @@index([createdAt])
  @@map("users")
}

model Company {
  id             String   @id // Whop company ID (biz_xxx)
  name           String
  experienceId   String   @unique @map("experience_id")
  settings       Json     @default("{}") @db.JsonB
  installedAt    DateTime @default(now()) @map("installed_at")
  isActive       Boolean  @default(true) @map("is_active")
  uninstalledAt  DateTime? @map("uninstalled_at")

  // Relations
  posts          Post[]
  userCompanies  UserCompany[]
  reports        Report[]

  @@index([experienceId])
  @@index([isActive, installedAt])
  @@map("companies")
}

model UserCompany {
  id           BigInt    @id @default(autoincrement())
  userId       String    @map("user_id")
  companyId    String    @map("company_id")
  membershipId String?   @map("membership_id")
  hasAccess    Boolean   @default(true) @map("has_access")
  role         String    @default("member") // 'member', 'admin', 'owner'
  joinedAt     DateTime  @default(now()) @map("joined_at")
  lastVerified DateTime  @default(now()) @map("last_verified")
  expiresAt    DateTime? @map("expires_at")

  // Relations
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId], name: "unique_user_company")
  @@index([userId, hasAccess])
  @@index([userId, hasAccess, expiresAt])
  @@index([companyId])
  @@index([companyId, hasAccess])
  @@index([membershipId])
  @@index([expiresAt])
  @@map("user_companies")
}

// ============================================================================
// POSTS & MEDIA
// ============================================================================

model Post {
  id            BigInt    @id @default(autoincrement())
  uuid          String    @unique @default(uuid()) @db.Uuid
  userId        String    @map("user_id")
  companyId     String    @map("company_id")
  experienceId  String    @map("experience_id")
  title         String?   @db.VarChar(200) // Blog title (optional for backward compatibility)
  content       String    @db.Text
  contentType   String    @default("text") @map("content_type") // 'text', 'image', 'link'
  isPinned      Boolean   @default(false) @map("is_pinned")
  isDeleted     Boolean   @default(false) @map("is_deleted")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  // Cached counts
  likesCount    Int       @default(0) @map("likes_count")
  commentsCount Int       @default(0) @map("comments_count")

  // Relations
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  media         PostMedia[]
  links         PostLink[]
  likes         Like[]
  comments      Comment[]

  @@index([companyId, createdAt(sort: Desc), isDeleted])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([companyId, isPinned, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("posts")
}

model PostMedia {
  id           BigInt   @id @default(autoincrement())
  postId       BigInt   @map("post_id")
  mediaType    String   @map("media_type") // 'image', 'video', 'gif'
  url          String   @db.Text
  thumbnailUrl String?  @map("thumbnail_url") @db.Text
  width        Int?
  height       Int?
  fileSize     Int?     @map("file_size")
  mimeType     String?  @map("mime_type") @db.VarChar(100)
  displayOrder Int      @default(0) @map("display_order")
  altText      String?  @map("alt_text") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, displayOrder])
  @@map("post_media")
}

model PostLink {
  id           BigInt   @id @default(autoincrement())
  postId       BigInt   @map("post_id")
  url          String   @db.Text
  title        String?  @db.VarChar(500)
  description  String?  @db.Text
  imageUrl     String?  @map("image_url") @db.Text
  domain       String?  @db.VarChar(255)
  fetchSuccess Boolean  @default(true) @map("fetch_success")
  fetchError   String?  @map("fetch_error") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_links")
}

// ============================================================================
// ENGAGEMENT
// ============================================================================

model Like {
  id        BigInt   @id @default(autoincrement())
  postId    BigInt   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId], name: "unique_user_post_like")
  @@index([postId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("likes")
}

model Comment {
  id              BigInt    @id @default(autoincrement())
  uuid            String    @unique @default(uuid()) @db.Uuid
  postId          BigInt    @map("post_id")
  userId          String    @map("user_id")
  parentCommentId BigInt?   @map("parent_comment_id")
  content         String    @db.Text
  isDeleted       Boolean   @default(false) @map("is_deleted")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  repliesCount    Int       @default(0) @map("replies_count")

  // Relations
  post            Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentComment   Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[] @relation("CommentReplies")

  @@index([postId, createdAt, isDeleted])
  @@index([postId, createdAt])
  @@index([parentCommentId, createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@map("comments")
}

// ============================================================================
// NOTIFICATIONS (Optional - v2)
// ============================================================================

model Notification {
  id          BigInt    @id @default(autoincrement())
  userId      String    @map("user_id") // Recipient
  actorId     String    @map("actor_id") // Person who triggered
  type        String    @db.VarChar(50) // 'like', 'comment', 'reply', 'mention', 'pin'
  targetType  String    @map("target_type") @db.VarChar(50) // 'post', 'comment'
  targetId    BigInt    @map("target_id")
  previewText String?   @map("preview_text") @db.Text
  companyId   String?   @map("company_id")
  isRead      Boolean   @default(false) @map("is_read")
  createdAt   DateTime  @default(now()) @map("created_at")
  readAt      DateTime? @map("read_at")

  // Relations
  recipient   User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor       User      @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================================
// MODERATION (Optional - v2)
// ============================================================================

model Report {
  id           BigInt    @id @default(autoincrement())
  reporterId   String    @map("reporter_id")
  reportedType String    @map("reported_type") @db.VarChar(50) // 'post', 'comment', 'user'
  reportedId   String    @map("reported_id") @db.VarChar(255)
  companyId    String    @map("company_id")
  reason       String    @db.VarChar(100) // 'spam', 'harassment', 'inappropriate', 'other'
  description  String?   @db.Text
  status       String    @default("pending") @db.VarChar(50) // 'pending', 'reviewed', 'actioned', 'dismissed'
  reviewedBy   String?   @map("reviewed_by")
  reviewedAt   DateTime? @map("reviewed_at")
  actionTaken  String?   @map("action_taken") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")

  // Relations
  reporter     User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status, createdAt(sort: Desc)])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([reportedType, reportedId])
  @@index([reporterId])
  @@map("reports")
}

// ============================================================================
// WEBHOOKS & EVENTS
// ============================================================================

model WebhookEvent {
  id          BigInt    @id @default(autoincrement())
  eventType   String    @map("event_type") @db.VarChar(100)
  eventId     String?   @map("event_id") @db.VarChar(255)
  payload     Json      @db.JsonB
  processed   Boolean   @default(false)
  error       String?   @db.Text
  retryCount  Int       @default(0) @map("retry_count")
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")

  @@index([eventType, createdAt])
  @@index([eventId])
  @@index([processed, createdAt])
  @@index([createdAt])
  @@map("webhook_events")
}
